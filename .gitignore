# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing / generated caches
/coverage
/.cache/

# Next.js and static export output
/.next/
/out/
/build

# Local environment and secrets
.env*
!.env.example
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# TypeScript and deployment artifacts
*.tsbuildinfo
next-env.d.ts
.vercel

# NOTE: data/*.json is intentionally NOT ignored. The JLPT JSON datasets are
# version-controlled source data and must be committed with the application.
